generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  entries   JournalEntry[]
  createdAt DateTime  @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String?
  content   String
  date      String   // YYYY-MM-DD
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
